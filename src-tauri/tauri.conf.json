{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "whale-stress-app",
  "version": "0.1.0",
  "identifier": "com.whale.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "whale-stress-app",
        "width": 400,
        "height": 720,
        "minWidth": 360,
        "minHeight": 540,
        "maxWidth": 1400,
        "maxHeight": 1000,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyQkRGRUUwOEZBNzc4MjIKUldRaWVLZVA0UDY5Y3YzYWlrOWhtSFF6WmljY3RpaWdGV1NXU3lERWRSVlN6Y3gvSytDVnBsYlcK",
      "endpoints": [
        "https://github.com/BugNoTensei/whale-stress-app/releases/latest/download/latest.json"
      ]
    }
  }
}
